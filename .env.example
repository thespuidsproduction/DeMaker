# The Confused Bookstore — environment.
#
# Copy to .env for local work, or paste these into Vercel under
# Project → Settings → Environment Variables. Never commit the filled-in
# version: .env is ignored, .env.example (this file) is not.
#
# /api/setup-check will tell you which of these are still missing.

# ── Stripe ────────────────────────────────────────────────────────────────
# sk_test_… while you are trying it, sk_live_… when you mean it.
STRIPE_SECRET_KEY=

# From Developers → Webhooks → your endpoint. Subscribe that endpoint to
# checkout.session.completed AND checkout.session.async_payment_succeeded.
STRIPE_WEBHOOK_SECRET=

# ── Email ─────────────────────────────────────────────────────────────────
# resend.com — the free tier is enough to start.
RESEND_API_KEY=
# On a domain verified with Resend, or nothing will send.
MAIL_FROM="The Alpha Acquirer Institute <books@yourdomain.com>"

# ── Downloads ─────────────────────────────────────────────────────────────
# Signs the expiring download links. Any long random string: openssl rand -hex 32
# Changing it invalidates every link already in a buyer's inbox.
DOWNLOAD_SECRET=

# Where the purchasable files actually live — private URLs, never this repo.
# Keys match `files` on the editions in src/content/book.js.
BOOK_FILES={"ebook-vol-1":"https://…","ebook-vol-2":"https://…","audiobook-vol-1":"https://…","audiobook-vol-2":"https://…"}

# ── Optional ──────────────────────────────────────────────────────────────
# Set if you do not want the request's own host used in links and redirects.
SITE_URL=

# Countries you will post a hardcover to. Unset uses a sensible default.
SHIP_TO=GB,IE,US,CA,AU,NZ,FR,DE,ES,IT,NL,BE,AT,PT,SE,DK,NO,FI,PL

# Unlocks POST /api/invoice for wholesale orders. Unset, that endpoint
# refuses everything. openssl rand -hex 32
WHOLESALE_API_KEY=

# Let Stripe convert prices into the buyer's local currency. Off by default —
# this shop charges the same number in every currency. See CONTENT.md §4.
STRIPE_ADAPTIVE_PRICING=false
