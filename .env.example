# ═══════════════════════════════════════════════════════════════════════════
# THE CHANNEL
#
# The destination lives here and nowhere else. It is read server side inside
# src/app/api/channel/route.ts and never reaches the browser.
#
# Set ONE of the options below. They are tried in this order and the first
# one that is configured wins. Copy this file to .env.local for development,
# and set the same variables in your host for production.
# ═══════════════════════════════════════════════════════════════════════════


# ── 1. Resend ──────────────────────────────────────────────── recommended ──
# Best deliverability, and mail comes from a domain you own. Free tier is
# 3,000 emails a month, 100 a day. Needs princey.dev verified in Resend.
#   https://resend.com
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# CONTACT_TO=your-real-address@example.com
# CONTACT_FROM=princey.dev <channel@princey.dev>


# ── 2. Web3Forms ─────────────────────────────────── best zero-setup option ──
# Free, no domain to verify. Enter an email at web3forms.com, they send you an
# access key, paste it here. 250 submissions a month.
#   https://web3forms.com
# WEB3FORMS_KEY=00000000-0000-0000-0000-000000000000


# ── 3. Formspree ───────────────────────────────────────────────────────────
# Free tier is 50 submissions a month. The form id hides the destination.
#   https://formspree.io
# FORMSPREE_ID=xxxxxxxx


# ── 4. Telegram ────────────────────────────────────── free and unlimited ──
# Lands on your phone in about a second, with no email deliverability to worry
# about. Talk to @BotFather to make a bot, then @userinfobot for your chat id.
# TELEGRAM_BOT_TOKEN=0000000000:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# TELEGRAM_CHAT_ID=000000000


# ── 5. FormSubmit ──────────────────────────────── no account whatsoever ──
# Free and unlimited. Set CONTACT_TO on its own and nothing else: the first
# message triggers a confirmation email you click once. Because this call is
# made server side, the address still never reaches the browser.
#   https://formsubmit.co
# CONTACT_TO=your-real-address@example.com


# ── 6. Any JSON endpoint ───────────────────────────────────────────────────
# A Discord or Slack webhook, an automation runner, your own service. It
# receives { source, name, replyTo, message, meta }.
# CONTACT_WEBHOOK_URL=https://discord.com/api/webhooks/...


# With none of these set, GET /api/channel reports "offline" and the console
# says so rather than accepting a message it cannot deliver.
