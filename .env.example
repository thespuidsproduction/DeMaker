# ═══════════════════════════════════════════════════════════════════════════
# THE CHANNEL
# The destination address lives here and nowhere else. It is read server-side
# inside src/app/api/channel/route.ts and never reaches the browser.
# Copy to .env.local for development; set these in your host for production.
# ═══════════════════════════════════════════════════════════════════════════

# ── Option A — Resend (recommended) ────────────────────────────────────────
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# CONTACT_TO=the-real-address@example.com
# Must be a domain verified in Resend. Optional; a sane default is used.
# CONTACT_FROM=princey.dev <channel@princey.dev>

# ── Option B — any HTTPS endpoint that accepts JSON ────────────────────────
# Receives { source, name, replyTo, message, meta }.
# CONTACT_WEBHOOK_URL=https://hooks.example.com/...

# With neither set, GET /api/channel reports "offline" and the console says so
# rather than accepting a message it cannot deliver.
